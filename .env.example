# asr-eval 环境变量样例 —— 复制为 .env 后填值（.env 不入仓）。
# 公开版不内置任何服务地址：所有端点默认为空，需要哪个 adapter 就配置哪个。

# ── 厂商 ASR 密钥 ──────────────────────────────────────────────
# 看板「添加接口」选厂商预设时，Key 框留空 → 运行时从下面对应环境变量读，
# 密钥不落进 dashboard/interfaces.json。
OPENAI_API_KEY=
DASHSCOPE_API_KEY=          # 阿里 DashScope（Qwen3-ASR + Qwen LiveTranslate 同传 qwen-simult 共用）
MIMO_API_KEY=               # 小米 MiMo ASR（Chat Completions + input_audio）

# ── 第三方同传：科大讯飞同声传译（xf-simult，WS hmac 鉴权）──────────
XF_APPID=
XF_API_KEY=
XF_API_SECRET=

# ── 第三方同传：豆包同声传译 2.0 / 火山引擎 AST（doubao-simult，protobuf WS）──
DOUBAO_APPID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_SECRET_KEY=

# ── 同传 tts_err 回转 re-ASR：本地 faster-whisper 模型档位（small/medium/large-v3，默认 small）──
# WHISPER_MODEL=small

# ── 自托管端点（默认全部为空）────────────────────────────────────
# ASR_PLATFORM_URL=            # 自托管 ASR 平台 HTTP 地址（Bearer 鉴权）
# ASR_PLATFORM_WS_URL=         # 可选；不填则 WS 同样走 ASR_PLATFORM_URL
# ASR_PLATFORM_TOKEN=          # 平台 Bearer Token；请通过密钥管理注入
# ASR_OPENAI_AUDIO_URL=        # OpenAI 兼容 audio 接口
# EXT_PRO_URL=
# LITE_URL=
# GEMMA_URL=
# GEMMA_KEY=                   # gemma 端点 Bearer key
# SENSEVOICE_URL=
# QWEN3_ASR_URL=               # 远程 Qwen3-ASR（asr_lite 协议）
# QWEN3_ASR_WS_URL=            # Qwen3-ASR 真流式 WS 地址
# EMB_URL / EMB_MODEL          # 语义相似度 embedding 端点（可选增强）
# EMB_KEY=

# ── 看板服务 ─────────────────────────────────────────────────
# DASH_HOST=127.0.0.1
# DASH_PORT=8088
# HTTP Basic 鉴权账号密码。对外暴露时必须设置随机强密码；仅本机隔离开发可把 DASH_PASS 留空关闭鉴权。
# DASH_USER=admin
# DASH_PASS=
